RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301] 

# Cloudflare Turnstile secret key used by forms/recruitment.php.
# Replace the placeholder with the secret key in the production copy.
SetEnv TURNSTILE_SECRET_KEY "WPROWADZ_TUTAJ_TURNSTILE_SECRET_KEY"